---
export interface Props {
  title: string;
  href?: string;
  linkText?: string;
  accent?: 'orange' | 'aqua';
}

const {
  title,
  href,
  linkText = 'Learn more',
  accent = 'orange',
} = Astro.props;
---

<article class:list={['feature-card', `feature-card--${accent}`]}>
  <div class="feature-card__body">
    <h2>{title}</h2>
    <div class="feature-card__content">
      <slot />
    </div>
  </div>

  {href && (
    <a class="text-link" href={href}>
      {linkText}
      <span aria-hidden="true">→</span>
    </a>
  )}
</article>
