---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="hero">
    <div class="container">
      <img
        class="hero-logo"
        src="/images/pchs-flag.png"
        alt="Plant City High School Flag"
      />

      <h1>Plant City High School</h1>
      <h2>Class of 1980</h2>
      <p>
        Welcome to the online home of the Plant City High School Class of 1980. Whether we're
        planning our next reunion, sharing memories, supporting classmates through our
        <strong>We Still Care</strong> fund, or simply staying connected, this is our home on the
        web.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="card">
        <h2>Latest News</h2>
        <p>
          There are currently no reunion events scheduled. Please check back periodically for class
          news, gatherings, and future reunion announcements.
        </p>
      </div>

      <div class="card">
        <h2>Upcoming Events</h2>
        <p>
          Check back soon for reunion dates, class gatherings, and other opportunities to reconnect.
        </p>
      </div>

      <div class="card">
        <h2>We Still Care</h2>
        <p>
          A place for classmates to stay connected, support one another, and keep the spirit of our
          class community strong.
        </p>
      </div>
    </div>
  </section>
</Layout>
